# Entrée HTTPS d'Alambic Search (certificats Let's Encrypt automatiques).
{
	email {$ACME_EMAIL}
}

{$SEARCH_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# Adresse virtuelle du service « api » : Swarm répartit entre ses instances saines
	# (celles dont le healthcheck passe) ; une instance arrêtée sort de la répartition.
	reverse_proxy api:8000 {
		fail_duration 10s
	}
}
