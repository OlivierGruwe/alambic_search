# Copier en deploy/swarm/stack.env (non versionné), puis : make stack-deploy
REGISTRY=registry.arondor.local/alambic
TAG=0.9.0-beta.1
SEARCH_HOST=search.client.fr
ACME_EMAIL=exploitation@arondor.fr
CLIENT_NAME=Client
# Alambic Light vu depuis le Swarm (défaut : service light_api de la stack « light », réseau « alambic »)
# LIGHT_URL=http://light_api:8000
LLM_MODEL=qwen2.5:7b
# LLM en ligne (Mistral AI, France) : réponses rapides sans carte graphique. La question et les
# extraits autorisés sont envoyés à Mistral ; les vecteurs restent calculés en local (bge-m3).
# Clé : secret search_llm_api_key (secrets.sh). Vide : Ollama, comme les vecteurs.
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest
# Reclassement désactivé : RERANK_URL= (vide)
RERANK_URL=http://rerank:80
# RERANK_IMAGE=ghcr.io/huggingface/text-embeddings-inference:1.8
# Taille des lots du reranker (mémoire) : 4096 en CPU ; 16384 possible sur carte graphique
# RERANK_BATCH_TOKENS=4096
# À incrémenter quand Caddyfile, sources.yaml, db-init.sh, backup.sh ou le royaume changent
# (les configs Docker sont immuables : nouveau nom = nouvelle version)
CONFIG_VERSION=1

# Rôle des nœuds qui portent les services applicatifs (api, worker, gotenberg) : worker ou manager.
# Swarm à un seul nœud (poste de dev, petit serveur) : APP_ROLE=manager
# APP_ROLE=worker
# Carte NVIDIA réservée pour Ollama (stack.gpu.yml). 0 : Docker Desktop ou nœud sans carte déclarée.
# STACK_GPU=1
# Réseaux chiffrés entre nœuds (stack.chiffre.yml). 0 : Docker Desktop (module IPsec absent), nœud unique.
# STACK_CHIFFRE=1
# Ollama hors de la stack (ex. celui de docker compose, qui a accès au GPU sous Docker Desktop) :
# OLLAMA_URL=http://host.docker.internal:11434

# Rotation des secrets : nom du secret Docker à utiliser (défaut : nom de base). Exemple :
# SESSION_SECRET_SECRET=search_session_secret_v2
# SECRETS_KEY_SECRET=search_secrets_key_v2
# SECRETS_KEY_PREVIOUS_SECRET=search_secrets_key      # le temps de rechiffrer, puis retirer

# Sauvegardes : dossier du nœud base (à créer : mkdir -p /srv/alambic-search/backups), ou partage NFS
# pour qu'elles survivent à la perte du nœud (le rechargement automatique d'une base vide les lit) :
# BACKUP_FS_TYPE=nfs
# BACKUP_FS_OPTS=addr=10.0.0.50,rw,nfsvers=4
# BACKUP_DEVICE=:/export/alambic-search
# Docker Desktop (Windows) : /srv est effacé à chaque redémarrage, utiliser un dossier du disque,
# ici D:\alambic-backups (créé à l'avance) ; déployer avec make (sinon : MSYS_NO_PATHCONV=1) :
# BACKUP_DEVICE=/run/desktop/mnt/host/d/alambic-backups

# Copie des sauvegardes vers un stockage S3 (stack.s3.yml). Secrets : BACKUP_S3=1 sh deploy/swarm/secrets.sh.
# Conservation côté S3 : règle de cycle de vie du bucket (ex. 90 jours). Restauration : README, « Sauvegardes ».
# BACKUP_S3=1
# S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net   # vide : AWS
# S3_REGION=gra                                  # obligatoire sur AWS : région du bucket (ex. eu-west-3)
# S3_BUCKET=client-alambic-sauvegardes
# S3_PREFIX=alambic-search
# S3_SSE=AES256                                  # chiffrement côté serveur, si le fournisseur le propose
# S3_INTERVAL=3600                               # secondes entre deux copies
