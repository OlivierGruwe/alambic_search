# Copier en .env pour le développement local (make run, make sync, make ask).
# Le fichier .env n'est pas à versionner.

# Base du projet lancée par `make db` (port 5433 pour ne pas gêner un PostgreSQL local)
# 127.0.0.1 plutôt que localhost : sous Windows, localhost tente d'abord IPv6 (~2 s perdues par connexion)
DATABASE_URL=postgresql://ged:ged@127.0.0.1:5433/ged

# Ollama lancé par `make db` (modèles : make pull-models)
EMBED_BASE_URL=http://127.0.0.1:11434/v1
EMBED_MODEL=bge-m3
EMBED_DIM=1024
LLM_BASE_URL=http://127.0.0.1:11434/v1
# 8 Go de mémoire vidéo : modèle de 7-8 milliards de paramètres
LLM_MODEL=qwen2.5:7b
# LLM en ligne, Mistral AI (rapide, sans carte graphique ; la question et les extraits autorisés lui
# sont envoyés, les vecteurs restent locaux) :
#   LLM_BASE_URL=https://api.mistral.ai/v1      (make run)
#   LLM_BASE_URL_DOCKER=https://api.mistral.ai/v1   (docker compose)
#   LLM_MODEL=mistral-small-latest
#   LLM_API_KEY=…
# Vide (LLM_MODEL=) : pas de formulation par un LLM, les questions renvoient les extraits
# pertinents avec leurs références. Par question : "formuler": false dans /ask.

# Reclassement des résultats (facultatif, `make rerank` démarre le service sur le port 8082).
# Gain de pertinence le plus net d'un RAG ; à mesurer sur le jeu de questions (make eval).
# RERANK_URL=http://127.0.0.1:8082
# RERANK_API=tei                 # tei (Text Embeddings Inference) ou jina (Jina, Cohere, llama.cpp, Infinity)
# RERANK_MODEL=BAAI/bge-reranker-v2-m3
# RERANK_CANDIDATES=40           # passages reclassés par question
# Carte NVIDIA (make rerank-gpu) : ghcr.io/huggingface/text-embeddings-inference:1.8 (RTX 30xx/40xx)
# ou …:turing-1.8 (RTX 20xx)
# RERANK_IMAGE=ghcr.io/huggingface/text-embeddings-inference:1.8
# Modèle téléchargé sur le poste (make rerank-modele) quand le conteneur ne peut pas le télécharger :
# RERANK_MODEL_ID=/models/bge-reranker-v2-m3

# Conversion PDF des fichiers bureautiques (Gotenberg lancé par `make db`) : vraies pages pour
# .docx/.xlsx/.pptx/.odt…, et typage par Alambic Light. Vide : .docx sans pagination, autres ignorés.
CONVERT_URL=http://127.0.0.1:3000

# Sources à indexer (copier sources.example.yaml et adapter les chemins à ton poste)
SOURCES_FILE=sources.yaml

# Chiffrement des mots de passe et secrets des sources saisis dans la console (AES-256-GCM).
# Générer : make secrets-key. À sauvegarder À PART (jamais avec la base) : sans elle, les secrets
# sont à ressaisir. Avec Docker secrets : SECRETS_KEY_FILE=/run/secrets/alambic_secrets_key.
# Rotation : nouvelle clé dans SECRETS_KEY, l'ancienne dans SECRETS_KEY_PREVIOUS, puis make secrets-rotate.
# Vide : saisie désactivée, les secrets restent dans des variables (*_env) ci-dessous.
SECRETS_KEY=
# SECRETS_KEY_PREVIOUS=

# Premier démarrage, base sans aucun compte : crée le compte « admin » (administrateur) avec ce
# mot de passe. Ensuite sans effet : les comptes se gèrent dans la console (Utilisateurs).
ADMIN_PASSWORD=change-moi

# Connexion des utilisateurs (page /) : clé de signature des sessions, longue et secrète.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sans clé : clé aléatoire, chacun doit se reconnecter après chaque redémarrage.
SESSION_SECRET=
# true derrière HTTPS (cookie envoyé seulement en HTTPS)
COOKIE_SECURE=false
# true SEULEMENT derrière un proxy qui pose lui-même X-User : sinon chacun se déclare qui il veut
TRUST_IDENTITY_HEADERS=false

# Secrets référencés par sources.yaml (password_env / bind_password_env / api_key_env)
# SMB_PASSWORD=
# LDAP_PASSWORD=
# ALAMBIC_LIGHT_API_KEY=
# Sources de GED (noms libres, à reporter dans le formulaire de la source) :
# FTP_PASSWORD=
# S3_SECRET=
# ALFRESCO_PASSWORD=
# CMIS_PASSWORD=
# SHAREPOINT_SECRET=     (secret de l'application Entra ID : penser à son expiration)

# Alambic Light (section alambic_light de sources.yaml) : adresse vue depuis le poste (make run)
# et depuis le conteneur api (make up), où 127.0.0.1 désigne le conteneur lui-même.
# ALAMBIC_LIGHT_URL=http://127.0.0.1:8001
# ALAMBIC_LIGHT_URL_DOCKER=http://host.docker.internal:8001

# Dossier du poste à indexer : utilisé par sources.yaml (root: ${DOCUMENTS_DIR}) avec make run,
# et monté dans le conteneur sous /data/partage avec make up / make up-gpu.
DOCUMENTS_DIR=D:/documents

# --- Pile Docker (make up / make up-gpu) ---
OLLAMA_CONTEXT_LENGTH=8192

# Synchronisations planifiées dans cette instance (false : instance web seule, en Swarm le
# service « worker » planifie). Un verrou PostgreSQL par source évite les doubles synchros.
# SCHEDULER_ENABLED=true
# Index vide au démarrage (base perdue sans sauvegarde) : toutes les sources resynchronisées par
# l'instance qui planifie. false : ne rien lancer automatiquement.
# AUTO_SYNC_EMPTY=true
