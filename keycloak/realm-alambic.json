{
  "realm": "alambic",
  "displayName": "Alambic",
  "enabled": true,
  "loginWithEmailAllowed": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "en"
  ],
  "defaultLocale": "fr",
  "groups": [
    {
      "name": "direction"
    },
    {
      "name": "compta"
    },
    {
      "name": "rh"
    },
    {
      "name": "tous"
    }
  ],
  "roles": {
    "client": {
      "alambic-search": [
        {
          "name": "admin",
          "description": "Console d'administration d'Alambic Search"
        },
        {
          "name": "utilisateur",
          "description": "Recherche (droits des documents appliqués)"
        }
      ],
      "alambic-light": [
        {
          "name": "admin",
          "description": "Gestion des types, exploitation"
        },
        {
          "name": "validation",
          "description": "Écran de validation des données extraites"
        },
        {
          "name": "lecture",
          "description": "Tableau de bord et statistiques"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "alambic-search",
      "name": "Alambic Search",
      "description": "GED interrogeable",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-alambic-search-a-changer",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:8002/auth/callback",
        "http://127.0.0.1:8002/auth/callback",
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8002/connexion*##http://127.0.0.1:8002/connexion*"
      },
      "protocolMappers": [
        {
          "name": "groupes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience alambic-search",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "alambic-search",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins"
      ]
    },
    {
      "clientId": "alambic-light",
      "name": "Alambic Light",
      "description": "Typage, extraction et validation des documents",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-alambic-light-a-changer",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:8001/*",
        "http://127.0.0.1:8001/*"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8001/*##http://127.0.0.1:8001/*"
      },
      "protocolMappers": [
        {
          "name": "groupes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "audience alambic-light",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "alambic-light",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "web-origins"
      ]
    }
  ],
  "users": [
