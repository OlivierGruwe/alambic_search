      "item": [
        {
          "name": "Question — réponse rédigée",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "description": "Réponse rédigée par le LLM, avec citations [n] → fichier, page, lien. Les droits sont appliqués AVANT le LLM.",
            "url": {
              "raw": "{{baseUrl}}/ask",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ask"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Quelle est la pénalité de retard du contrat de maintenance ?\",\n  \"k\": 8\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Garde le premier document cité pour « Ouvrir » et « Vignette »",
                  "const r = pm.response.json();",
                  "const c = (r.citations || [])[0] || (r.documents || [])[0] || (Array.isArray(r) ? r[0] : null);",
                  "if (c && c.url) {",
                  "  pm.collectionVariables.set(\"doc_url\", c.url.split(\"#\")[0]);",
                  "  const m = c.url.match(/^\\/documents\\/([^/]+)\\/(.+?)(\\?|#|$)/);",
                  "  if (m) { pm.collectionVariables.set(\"source\", m[1]); pm.collectionVariables.set(\"doc_path\", m[2]); }",
                  "  pm.collectionVariables.set(\"page\", String(c.page || ((c.url.match(/#page=(\\d+)/) || [])[1]) || 1));",
                  "}",
                  "pm.test(\"200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
